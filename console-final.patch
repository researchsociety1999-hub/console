diff --git a/tests/storage.test.js b/tests/storage.test.js
new file mode 100644
index 0000000..09d7be3
--- /dev/null
+++ b/tests/storage.test.js
@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vitest';
+import { Vault } from '../js/storage.js';
+
+function makeStorage() {
+  const values = new Map();
+  return {
+    getItem(key) { return values.has(key) ? values.get(key) : null; },
+    setItem(key, value) { values.set(key, String(value)); },
+    removeItem(key) { values.delete(key); },
+  };
+}
+
+async function withStorage(fn) {
+  const previousStorage = globalThis.localStorage;
+  const previousIndexedDB = globalThis.indexedDB;
+  globalThis.localStorage = makeStorage();
+  globalThis.indexedDB = {};
+  try {
+    return await fn(globalThis.localStorage);
+  } finally {
+    if (previousStorage === undefined) delete globalThis.localStorage;
+    else globalThis.localStorage = previousStorage;
+    if (previousIndexedDB === undefined) delete globalThis.indexedDB;
+    else globalThis.indexedDB = previousIndexedDB;
+  }
+}
+
+describe('Encrypted Vault', () => {
+  it('initializes a passphrase verifier and only unlocks with the same passphrase', async () => {
+    await withStorage(async (storage) => {
+      const vault = new Vault();
+      await vault.unlock('correct horse battery staple');
+      expect(vault.isUnlocked).toBe(true);
+      expect(storage.getItem('console-vault-salt')).toMatch(/^[0-9a-f]{32}$/i);
+      expect(storage.getItem('console-vault-key-check')).toBeTruthy();
+
+      vault.lock();
+      await expect(vault.unlock('wrong horse battery staple')).rejects.toThrow(/Incorrect vault passphrase/);
+      expect(vault.isUnlocked).toBe(false);
+      await vault.unlock('correct horse battery staple');
+      expect(vault.isUnlocked).toBe(true);
+    });
+  });
+
+  it('refuses to adopt a new passphrase for an existing vault with no verifier', async () => {
+    await withStorage(async (storage) => {
+      storage.setItem('console-vault-salt', '00112233445566778899aabbccddeeff');
+      const vault = new Vault();
+      await expect(vault.unlock('new passphrase value')).rejects.toThrow(/no passphrase verifier/);
+      expect(vault.isUnlocked).toBe(false);
+      expect(storage.getItem('console-vault-key-check')).toBe(null);
+    });
+  });
+
+  it('rejects short passphrases before initializing storage', async () => {
+    await withStorage(async (storage) => {
+      const vault = new Vault();
+      await expect(vault.unlock('short')).rejects.toThrow(/10 and 256 characters/);
+      expect(storage.getItem('console-vault-salt')).toBe(null);
+    });
+  });
+});
